static void KeyExpansion(uint8_t* RoundKey, const uint8_t* Key) {
    unsigned i,j,k;
    uint8_t tempa[4];
    for (i = 0; i < 16; i++) RoundKey[i] = Key[i];
    for (i = 16; i < 240; i += 4) {
        for (j = 0; j < 4; j++) tempa[j] = RoundKey[i + j - 4];
        if (i % 16 == 0) {
            uint8_t t = tempa[0];
            tempa[0] = tempa[1];
            tempa[1] = tempa[2];
            tempa[2] = tempa[3];
            tempa[3] = t;
            for (j = 0; j < 4; j++) tempa[j] = sbox[tempa[j]];
            tempa[0] ^= Rcon[i/16];
        } else if (i % 16 == 8) {
            for (j = 0; j < 4; j++) tempa[j] = sbox[tempa[j]];
        }
        for (j = 0; j < 4; j++) RoundKey[i+j] = RoundKey[i+j-16] ^ tempa[j];
    }
}

static void AddRoundKey(uint8_t round, uint8_t state[4][4], const uint8_t* RoundKey) {
    for (uint8_t c = 0; c < 4; c++)
        for (uint8_t r = 0; r < 4; r++)
            state[r][c] ^= RoundKey[(round << 2) + (c << 2) + r];
}

static void InvSubBytes(uint8_t state[4][4]) {
    for (uint8_t r = 0; r < 4; r++)
        for (uint8_t c = 0; c < 4; c++)
            state[r][c] = rsbox[state[r][c]];
}

static void InvShiftRows(uint8_t state[4][4]) {
    uint8_t t;
    for (uint8_t r = 1; r < 4; r++) {
        for (uint8_t c = 0; c < r; c++) {
            t = state[r][3];
            for (uint8_t i = 3; i > 0; i--) state[r][i] = state[r][i-1];
            state[r][0] = t;
        }
    }
}

static void InvMixColumns(uint8_t state[4][4]) {
    uint8_t a[4][4];
    for (uint8_t r = 0; r < 4; r++)
        for (uint8_t c = 0; c < 4; c++)
            a[r][c] = state[r][c];
    for (uint8_t c = 0; c < 4; c++) {
        state[0][c] = (a[0][c] ? 0x0e : 0) ^ (a[1][c] ? 0x0b : 0) ^ (a[2][c] ? 0x0d : 0) ^ (a[3][c] ? 0x09 : 0);
        state[1][c] = (a[0][c] ? 0x09 : 0) ^ (a[1][c] ? 0x0e : 0) ^ (a[2][c] ? 0x0b : 0) ^ (a[3][c] ? 0x0d : 0);
        state[2][c] = (a[0][c] ? 0x0d : 0) ^ (a[1][c] ? 0x09 : 0) ^ (a[2][c] ? 0x0e : 0) ^ (a[3][c] ? 0x0b : 0);
        state[3][c] = (a[0][c] ? 0x0b : 0) ^ (a[1][c] ? 0x0d : 0) ^ (a[2][c] ? 0x09 : 0) ^ (a[3][c] ? 0x0e : 0);
    }
}

static void InvCipher(uint8_t state[4][4], const uint8_t* RoundKey) {
    AddRoundKey(10, state, RoundKey);
    for (uint8_t round = 9; round > 0; round--) {
        InvShiftRows(state);
        InvSubBytes(state);
        AddRoundKey(round, state, RoundKey);
        InvMixColumns(state);
    }
    InvShiftRows(state);
    InvSubBytes(state);
    AddRoundKey(0, state, RoundKey);
}

void AES_init_ctx_iv(AES_ctx* ctx, const uint8_t* key, const uint8_t* iv) {
    KeyExpansion(ctx->RoundKey, key);
    memcpy(ctx->Iv, iv, 16);
}

void AES_CBC_decrypt_buffer(AES_ctx* ctx, uint8_t* buf, size_t length) {
    if (length % 16 != 0) return;
    uint8_t block[16];
    for (size_t i = 0; i < length; i += 16) {
        memcpy(block, buf + i, 16);
        uint8_t state[4][4];
        for (uint8_t r = 0; r < 4; r++)
            for (uint8_t c = 0; c < 4; c++)
                state[r][c] = block[(c << 2) + r];
        InvCipher(state, ctx->RoundKey);
        for (uint8_t r = 0; r < 4; r++)
            for (uint8_t c = 0; c < 4; c++)
                block[(c << 2) + r] = state[r][c] ^ ctx->Iv[(c << 2) + r];
        memcpy(ctx->Iv, buf + i, 16);
        memcpy(buf + i, block, 16);
    }
}

uint64_t djb2_wide(const wchar_t* str) {
    uint64_t hash = 5381;
    while (*str) { hash = ((hash << 5) + hash) + *str; str++; }
    return hash;
}

uint64_t djb2_ansi(const char* str) {
    uint64_t hash = 5381;
    while (*str) { hash = ((hash << 5) + hash) + *str; str++; }
    return hash;
}

