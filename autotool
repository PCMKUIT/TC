Thêm Go vào PATH (nếu chưa):

export PATH=$PATH:$HOME/go/bin
Script: docfinder.sh
#!/bin/bash

DOMAIN="$1"

mkdir -p "$DOMAIN"
cd "$DOMAIN" || exit

echo "[+] Collecting URLs..."

(
gau "$DOMAIN"
waybackurls "$DOMAIN"
katana -u "https://$DOMAIN" -silent
) | sort -u > all_urls.txt

echo "[+] Filtering documents..."

grep -Ei '\.(pdf|doc|docx|xls|xlsx|ppt|pptx|csv|rtf|odt|ods)(\?|$)' all_urls.txt \
| sort -u > docs.txt

echo "[+] Found $(wc -l < docs.txt) documents"

mkdir -p docs

cd docs

wget -nv -nc -i ../docs.txt

echo "[+] Metadata"

exiftool * > ../metadata.txt

echo "[+] Done"
echo
echo "Documents : docs/"
echo "Metadata  : metadata.txt"
Chạy
chmod +x docfinder.sh
./docfinder.sh example.com

